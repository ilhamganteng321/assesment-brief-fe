{
  "name": "frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --port 3001",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . && biome check app components features lib providers scripts tests",
    "format": "biome check --write app components features lib providers scripts tests",
    "format:check": "biome check app components features lib providers scripts tests",
    "typecheck": "next typegen && tsc --noEmit --incremental false",
    "test": "bun test",
    "test:auth:integration": "bun scripts/verify-auth.mjs",
    "test:projects:integration": "bun scripts/verify-projects.mjs",
    "check": "bun run typecheck && bun run lint && bun test"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@phosphor-icons/react": "^2.1.10",
    "@tanstack/react-query": "^5.103.2",
    "axios": "^1.20.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "commitlint": "^21.2.3",
    "husky": "^9.1.7",
    "next": "16.3.6",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-hook-form": "^7.88.0",
    "shadcn": "^4.21.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.5",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.6",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
